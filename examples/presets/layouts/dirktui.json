{
  "name": "dirktui",
  "min_width": 24,
  "min_height": 6,
  "focus": "columns",
  "actions": {
    "app.details": "show what is known about the selected entry",
    "app.hidden": "show or hide dotfiles",
    "app.sort": "cycle name / size / modified",
    "app.help": "the live key table",
    "app.quit": "leave without choosing",
    "app.theme": "Edit the theme",
    "app.keys": "Edit the keys",
    "app.menu": "settings: sort, dotfiles, motion"
  },
  "root": {
    "column": [
      {
        "id": "path",
        "content": "input:path",
        "size": 1,
        "border": "none",
        "focusable": true
      },
      {
        "id": "columns",
        "content": "filepicker",
        "border": "single",
        "focusable": true
      },
      {
        "id": "find",
        "content": "input:find",
        "size": 1,
        "border": "none",
        "focusable": true
      }
    ]
  },
  "popups": [
    {
      "id": "matches",
      "dismiss": true,
      "x": "50%",
      "y": "50%",
      "w": "70%",
      "h": "70%",
      "anchor": "center",
      "min_w": 30,
      "min_h": 5,
      "modal": true,
      "root": {
        "id": "matches",
        "content": "menu:matches",
        "border": "rounded",
        "focusable": true,
        "background": "panel_background"
      }
    },
    {
      "id": "menu",
      "dismiss": true,
      "x": "50%",
      "y": "50%",
      "w": "72%",
      "h": 34,
      "anchor": "center",
      "min_w": 64,
      "max_w": 96,
      "min_h": 5,
      "modal": true,
      "root": {
        "id": "menu",
        "content": "menu:places",
        "border": "rounded",
        "title": "settings",
        "focusable": true,
        "background": "panel_background"
      }
    },
    {
      "id": "details",
      "dismiss": true,
      "x": "50%",
      "y": "50%",
      "w": "60%",
      "h": 11,
      "anchor": "center",
      "min_w": 28,
      "max_w": 76,
      "modal": true,
      "root": {
        "id": "details",
        "content": "rows:entry",
        "border": "rounded",
        "title": "entry",
        "focusable": true,
        "background": "panel_background"
