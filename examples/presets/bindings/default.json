{
  "name": "dirktui",
  "bindings": {
    "picker.up": [
      "up",
      "ctrl+p"
    ],
    "picker.down": [
      "down",
      "ctrl+n"
    ],
    "picker.out": [
      "left",
      "backspace"
    ],
    "picker.into": [
      "right"
    ],
    "picker.first": [
      "home"
    ],
    "picker.last": [
      "end"
    ],
    "picker.page_up": [
      "pageup"
    ],
    "picker.page_down": [
      "pagedown"
    ],
    "app.details": [
      "ctrl+d"
    ],
    "app.theme": [
      "f4"
    ],
    "app.keys": [
      "f5"
    ],
    "app.hidden": [
      "ctrl+.",
      "alt+h"
    ],
    "app.sort": [
      "ctrl+s"
    ],
    "app.help": [
      "f1"
    ],
    "app.quit": [
      "ctrl+q"
    ],
    "picker.take": [
      "enter"
    ],
    "picker.cancel": [
      "escape"
    ],
    "app.menu": [
      "f2"
    ],
    "picker.copy": [
      "ctrl+c"
    ],
    "picker.copy_inverse": [
      "alt+c"
    ]
  }
}
