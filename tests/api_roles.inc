/* ---- the layout family is a HANDLE, and these are its seven doors --------------------------
 * All of them are HOST_LOAD: a host gets a layout, hands its base to the stack, declares its
 * actions and shows its name — the shape `load → bind → run → release` already had. The two
 * node accessors are HOST_RUN: a host reads them off a node the library hands back mid-frame
 * (`rolltui_window_stack_focused`, a resolved node in a draw slot). */
ROLLTUI_ROLE(rolltui_layout_new, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layout_free, HOST_RELEASE)
ROLLTUI_ROLE(rolltui_layout_clone, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layout_base, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layout_actions, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layout_min_size, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layout_name, HOST_LOAD)
ROLLTUI_ROLE(rolltui_layer_placement, HOST_RUN)
ROLLTUI_ROLE(rolltui_layer_id, HOST_RUN)
ROLLTUI_ROLE(rolltui_layout_node_id, HOST_RUN)
ROLLTUI_ROLE(rolltui_layout_node_is_window, HOST_RUN)
