{
  "name": "vim-ish",
  "bindings": {
    "input.submit": ["enter"],
    "input.newline": ["alt+enter"],
    "input.backspace": ["backspace"],
    "input.delete": ["delete"],
    "input.kill_word_backward": ["ctrl+w"],
    "input.kill_word_forward": ["alt+d"],
    "input.kill_to_line_start": ["ctrl+u"],
    "input.kill_to_line_end": ["ctrl+k"],
    "input.left": ["left"],
    "input.right": ["right"],
    "input.word_left": ["alt+b"],
    "input.word_right": ["alt+f"],
    "input.line_start": ["home", "ctrl+a"],
    "input.line_end": ["end", "ctrl+e"],
    "input.up": ["up"],
    "input.down": ["down"],
    "input.select_left": ["shift+left"],
    "input.select_right": ["shift+right"],
    "input.select_word_left": ["alt+shift+b"],
    "input.select_word_right": ["alt+shift+f"],
    "input.select_line_start": ["shift+home"],
    "input.select_line_end": ["shift+end"],
    "input.select_up": ["shift+up"],
    "input.select_down": ["shift+down"],
    "input.select_all": ["ctrl+x"],
    "input.clear_selection": ["escape"],
    "input.copy": ["alt+c"],
    "input.eof": ["ctrl+d"],
    "transcript.page_up": ["pageup"],
    "transcript.page_down": ["pagedown"],
    "transcript.top": ["ctrl+home"],
    "transcript.bottom": ["ctrl+end"],
    "transcript.line_up": ["up"],
    "transcript.line_down": ["down"],
    "transcript.fold": ["ctrl+o"],
    "transcript.copy": ["alt+c"],
    "transcript.clear_selection": ["escape"],
    "menu.up": ["up"],
    "menu.down": ["down"],
    "menu.page_up": ["pageup"],
    "menu.page_down": ["pagedown"],
    "menu.first": ["home"],
    "menu.last": ["end"],
    "menu.activate": ["enter"],
    "menu.descend": ["right"],
    "menu.ascend": ["left"],
    "menu.back": ["escape"],
    "menu.erase": ["backspace"],
    "menu.clear_value": ["ctrl+u"],
    "stack.close_popup": ["escape"],
    "stack.focus_next": ["tab"],
    "stack.focus_prev": ["shift+tab"],
    "app.help": ["f1", "?"],
    "app.menu": ["f2"],
    "app.details": ["f3"],
    "app.palette": ["ctrl+p"],
    "app.repaint": ["ctrl+l"],
    "editor.undo": ["ctrl+z"],
    "editor.redo": ["ctrl+y"],
    "editor.theme": ["f4"],
    "editor.layout": ["f6"],
    "editor.keys": ["f7"],
    "playground.cycle_theme": ["f3"],
    "playground.reload": ["f5"],
    "playground.quit": ["ctrl+q"]
  }
}
