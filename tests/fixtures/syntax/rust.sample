use std::collections::HashMap;

/// A widget.
#[derive(Debug, Clone)]
pub struct Widget<'a, T: Display> {
    name: &'a str,
    items: Vec<T>,
}

impl<'a, T> Widget<'a, T> where T: Display {
    pub const MAX: usize = 0x1F_FF;
    pub fn new(name: &'a str) -> Self { Self { name, items: Vec::new() } }
    fn run(&mut self) -> Result<(), Box<dyn Error>> {
        /* block /* nested */ still comment */
        let c = 'x'; let nl = '\n'; let r = 1..=10u32;
        let raw = r#"a "quoted" \ string"#;
        let s = "line\twith \"escapes\" \u{1F600}";
        println!("{} {:?}", self.name, 3.14f64);
        for (i, item) in self.items.iter().enumerate() {
            match item { Some(v) if *v > 3 => break, _ => continue }
        }
        Ok(())
    }
}
