		{type|render}{punct|::}{type|vector}{punct|.}{function|fill_circle}(m->at, {number|3.0f}, {function|rgba}({number|0xE8F8FFFFu}));
	}
}

{type|void} {function|on_frame}({keyword|struct} {type|world} *w) {
	{keyword|const} {type|u8}[] line = {string|"wave }{punct|{}{variable|w}{punct|->}{variable|wave}{punct|}}{string| at }{punct|{}{variable|w}{punct|->}{variable|time}{punct|:}{number|.1}{punct|}}{string|s"};
	{type|render}{punct|::}{type|text}{punct|.}{function|draw}({type|render}{punct|::}{type|text}{punct|.}{constant|mono}, {string|"}{punct|{}{variable|w}{punct|->}{variable|points}{punct|}}{string|"}, {{number|24.0f}, {number|50.0f}}, {number|28.0f}, {{function|rgba}({number|0x112233FFu})});
	{type|events}{punct|::}{type|log}{punct|.}{function|info}({string|"}{punct|{}{variable|line}{punct|}}{string| and }{escape|{{}{string|braces}{escape|}}}{string| }{escape|\"}{string|quoted}{escape|\"}{string|"});
	{keyword|spawn} { mote{ .at = {{number|0.0f}, {number|0.0f}}, .v = {{number|1.0f}, {number|0.5e1f}} } };
	{type|i32} hits = {number|0x1F};  {comment|// a comment}
}
