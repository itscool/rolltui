{keyword|system} {attribute|sim} {type|void} {function|drift}(mote *m, {type|entity} self, {keyword|sends} splash, {keyword|const} {keyword|struct} {type|world} *w) {
	m->at += m->v * {type|time}{punct|::}{function|delta}();
	{keyword|if} (m->at.y > {number|120.0f} && w->lit != {constant|false}) {
		{function|send}(splash{ .at = m->at });
	}
}

{keyword|system} {attribute|frame} {type|void} {function|paint}({keyword|const} mote *m) {
