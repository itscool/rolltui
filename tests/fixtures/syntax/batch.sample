@echo off
REM Build script
:: another comment
setlocal EnableDelayedExpansion
set "OUT=%~dp0build"
if not exist "%OUT%" mkdir "%OUT%"
for /f "tokens=*" %%i in ('dir /b') do (
  echo Found %%i !errorlevel! 100%%
)
call :helper arg1 %1 %*
if %ERRORLEVEL% neq 0 goto :fail
echo Done ^& exit
goto :eof
:helper
  echo helper %~1
  exit /b 0
:fail
  exit /b 1
