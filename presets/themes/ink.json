    "effects": {
      "waiting": {
        "kind": "spinner",
        "frames": [
          "\u280b",
          "\u2819",
          "\u2839",
          "\u2838",
          "\u283c",
          "\u2834",
          "\u2826",
          "\u2827"
        ],
        "period_ms": 720
      },
      "streaming": {
        "kind": "shimmer",
        "roles": [
          "accent_1"
        ],
        "period_ms": 1400,
        "width": 5
      },
      "progress": {
        "kind": "bar",
        "roles": [
          "accent_2"
        ],
        "period_ms": 0
      },
      "flash": {
        "kind": "blink",
        "roles": [
          "find_current"
        ],
        "period_ms": 520
      },
      "streamed": {
        "kind": "shimmer",
        "roles": [
          "accent_1"
        ],
        "period_ms": 2800,
        "width": 5,
        "jitter": 55
      }
