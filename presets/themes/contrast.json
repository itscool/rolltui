{
  "name": "contrast",
  "mode": "auto",
  "depth": "auto",
  "colours": {
    "name": "contrast",
    "meta": {
      "description": "Strictly high contrast. White on black and black on white, every text role at 7:1 or better, and every must-differ pair carrying an attribute as well as a colour so it survives 16 colours and mono.",
      "badges": {
        "dark": [
          "dark",
          "high-contrast",
          "readable",
          "cvd-safe",
          "protan-safe",
          "deutan-safe",
          "tritan-safe",
          "16-safe",
          "256-safe",
          "attribute-redundant"
        ],
        "light": [
          "light",
          "high-contrast",
          "readable",
          "cvd-safe",
          "protan-safe",
          "deutan-safe",
          "tritan-safe",
          "16-safe",
          "256-safe",
          "attribute-redundant"
        ]
      }
    },
    "defs": {
      "bg": {
        "dark": "#000000",
        "light": "#ffffff"
      },
      "panel": {
        "dark": "#1c1c1c",
        "light": "#e8e8e8"
      },
      "code": {
        "dark": "#101010",
        "light": "#f2f2f2"
      },
      "fg": {
        "dark": "#ffffff",
        "light": "#000000"
      },
      "dim": {
        "dark": "#c9c9c9",
        "light": "#454545"
      },
      "line": {
        "dark": "#8f8f8f",
        "light": "#5c5c5c"
      },
      "focus": {
        "dark": "#7bbdff",
        "light": "#00477f"
      },
      "head": {
        "dark": "#b0d7ff",
        "light": "#00325d"
      },
      "a1": {
        "dark": "#63b2ff",
        "light": "#1c2587"
      },
      "a2": {
        "dark": "#04f09f",
        "light": "#00574c"
      },
      "a3": {
        "dark": "#fffcf6",
        "light": "#673d00"
      },
      "a4": {
        "dark": "#f169ca",
        "light": "#7d27ac"
      },
      "ok": {
        "dark": "#00e590",
        "light": "#006123"
      },
      "bad": {
        "dark": "#ff6d67",
        "light": "#6b002e"
      },
      "warn": {
        "dark": "#ffe4b6",
        "light": "#5f4100"
      },
      "link": {
        "dark": "#2dcdec",
        "light": "#004957"
