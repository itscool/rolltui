      },
      "scrollbar": {
        "fg": "focus",
        "bg": "bg"
      }
    },
    "effects": {
      "waiting": {
        "kind": "spinner",
        "frames": [
          "\u280b",
          "\u2819",
          "\u2839",
          "\u2838",
          "\u283c",
          "\u2834",
          "\u2826",
          "\u2827"
        ],
        "period_ms": 500
      },
      "streaming": {
        "kind": "pulse",
        "roles": [
          "text_muted",
          "text"
        ],
        "period_ms": 1100
      },
      "progress": {
        "kind": "bar",
        "roles": [
          "menu_selected"
        ],
        "period_ms": 0
      },
      "flash": {
        "kind": "blink",
        "roles": [
          "find_current"
        ],
        "period_ms": 400
      },
      "streamed": {
        "kind": "pulse",
        "roles": [
          "text_muted",
          "text"
        ],
        "period_ms": 2200,
        "jitter": 55
      }
    },
    "glyphs": {
      "scrollbar": {
        "single": "\u2503",
        "top": "\u2503",
        "middle": "\u2503",
        "bottom": "\u2503",
        "ascii": {
          "single": "#",
          "top": "#",
          "middle": "#",
          "bottom": "#"
        }
      }
    }
  }
}
