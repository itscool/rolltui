{
  "name": "C",
  "aliases": ["c"],
  "extensions": ["c"],
  "not_after": [".", "->"],
  "contexts": {
    "main": [
      { "region": { "begin": "/\\*[*!](?![*/])", "end": "\\*/", "class": "doc", "rules": [ { "match": "[@\\\\][A-Za-z]+", "class": "attribute" } ] } },
      { "region": { "begin": "/\\*", "end": "\\*/", "class": "comment" } },
      { "region": { "begin": "//[/!](?!/)", "class": "doc", "rules": [ { "match": "[@\\\\][A-Za-z]+", "class": "attribute" } ] } },
      { "region": { "begin": "//", "class": "comment" } },
      { "match": "^\\s*(#\\s*(?:include|import))\\s*(<[^>]*>|\"[^\"]*\")", "captures": { "1": "preproc", "2": "string" } },
      { "match": "^\\s*(#\\s*define)\\s+([A-Za-z_]\\w*)(?=\\()", "captures": { "1": "preproc", "2": "function" } },
      { "match": "^\\s*(#\\s*define)\\s+([A-Za-z_]\\w*)", "captures": { "1": "preproc", "2": "constant" } },
      { "match": "^\\s*#\\s*[a-z_]+", "class": "preproc" },
      { "region": { "begin": "\"", "end": "\"", "class": "string", "escape": "\\\\(?:x[0-9A-Fa-f]{1,2}|[0-7]{1,3}|.)", "single_line": true } },
      { "region": { "begin": "'", "end": "'", "class": "string", "escape": "\\\\(?:x[0-9A-Fa-f]{1,2}|[0-7]{1,3}|.)", "single_line": true } },
      { "match": "\\b(struct|union|enum)\\s+([A-Za-z_]\\w*)", "captures": { "1": "keyword", "2": "type" } },
      { "words": ["auto", "break", "case", "const", "continue", "default", "do", "else", "enum", "extern", "for", "goto", "if", "inline", "register", "restrict", "return", "sizeof", "static", "struct", "switch", "typedef", "union", "volatile", "while",
                  "_Alignas", "_Alignof", "_Atomic", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local", "alignas", "alignof", "constexpr", "noreturn", "static_assert", "thread_local", "typeof", "typeof_unqual",
                  "defined", "asm", "__asm__", "__inline__", "__attribute__", "__restrict", "__extension__", "__declspec", "__typeof__"], "class": "keyword" },
      { "words": ["char", "short", "int", "long", "float", "double", "void", "signed", "unsigned", "bool", "_Bool", "_Complex", "_Imaginary", "FILE", "DIR", "va_list"], "class": "type" },
      { "words": ["NULL", "true", "false", "nullptr", "EOF", "stdin", "stdout", "stderr", "__FILE__", "__LINE__", "__func__", "__FUNCTION__", "__DATE__", "__TIME__"], "class": "constant" },
      { "match": "\\b(?:0[xX][0-9A-Fa-f']+|0[bB][01']+|\\d[\\d']*(?:\\.\\d*)?(?:[eE][+-]?\\d+)?)[uUlLfF]*\\b", "class": "number" },
      { "match": "\\b[A-Za-z_]\\w*_t\\b", "class": "type" },
      { "match": "\\b[A-Z][A-Z0-9_]{2,}\\b", "class": "constant" },
      { "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()", "captures": { "1": "function" } }
    ]
  }
}
