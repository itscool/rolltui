{
  "name": "Java",
  "aliases": ["java"],
  "extensions": ["java", "jav"],
  "not_after": ["."],
  "contexts": {
    "main": [
      { "region": { "begin": "/\\*\\*(?!/)", "end": "\\*/", "class": "doc", "rules": [ { "match": "@\\w+", "class": "attribute" }, { "match": "</?[A-Za-z][\\w-]*>|\\{@\\w+", "class": "tag" } ] } },
      { "region": { "begin": "/\\*", "end": "\\*/", "class": "comment" } },
      { "region": { "begin": "//", "class": "comment" } },
      { "region": { "begin": "\"\"\"", "end": "\"\"\"", "class": "string", "escape": "\\\\(?:u+[0-9A-Fa-f]{4}|[0-7]{1,3}|.)" } },
      { "region": { "begin": "\"", "end": "\"", "class": "string", "escape": "\\\\(?:u+[0-9A-Fa-f]{4}|[0-7]{1,3}|.)", "single_line": true } },
      { "region": { "begin": "'", "end": "'", "class": "string", "escape": "\\\\(?:u+[0-9A-Fa-f]{4}|[0-7]{1,3}|.)", "single_line": true } },
      { "match": "\\b(class|interface|enum|record|extends|implements|permits|throws|new|instanceof)\\s+([A-Za-z_]\\w*)", "captures": { "1": "keyword", "2": "type" } },
      { "match": "@[A-Za-z_][\\w.]*", "class": "attribute" },
      { "match": "\\bnon-sealed\\b", "class": "keyword" },
      { "words": ["abstract", "assert", "break", "case", "catch", "class", "const", "continue", "default", "do", "else", "enum", "exports", "extends", "final", "finally", "for", "goto", "if", "implements", "import",
                  "instanceof", "interface", "module", "native", "new", "open", "opens", "package", "permits", "private", "protected", "provides", "public", "record", "requires", "return", "sealed",
                  "static", "strictfp", "super", "switch", "synchronized", "this", "throw", "throws", "to", "transient", "transitive", "try", "uses", "var", "volatile", "when", "while", "with", "yield"], "class": "keyword" },
      { "words": ["boolean", "byte", "char", "double", "float", "int", "long", "short", "void"], "class": "type" },
      { "words": ["true", "false", "null"], "class": "constant" },
      { "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?)[lLfFdD]?\\b", "class": "number" },
      { "match": "\\b[A-Z][A-Z0-9]*_[A-Z0-9_]*\\b", "class": "constant" },
      { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "class": "type" },
      { "match": "\\b([a-z_]\\w*)\\s*(?=\\()", "captures": { "1": "function" } }
    ]
  }
}
